# Local SDKs, caches, scratch work and isolated validation builds.
/work/

# Packaged deliverables are generated from the source project.
/outputs/*.apk
/outputs/*.zip
/outputs/artifact-manifest.json

# Local editor metadata and generated previews.
**/.idea/
**/*.iml
/outputs/attendance_app/previews/
/outputs/material-previews/

/outputs/create-history.ps1
/outputs/commit-plan.json

# Web/backend local runtime and build output.
/server/.local/
/server/target/
/server/src/main/resources/static/
**/.env
/.env

/outputs/*.jar
/.local/

# Private environment overrides, signing material, and database files.
**/.env.*
!**/.env.example
**/key.properties
**/*.jks
**/*.keystore
**/*.mv.db
**/*.trace.db
