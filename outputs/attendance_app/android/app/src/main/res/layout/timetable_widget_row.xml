<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tt_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp" android:orientation="vertical" android:background="@drawable/widget_row_background" android:padding="14dp">
    <TextView android:id="@+id/tt_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/tt_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/tt_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
</LinearLayout>
